# Gym Ontime frontend: environment variables. Copy to `.env.local` (never commit it).
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:5000/api
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001/api

# Firebase web push (optional: push is hidden if any of these is missing).
# Firebase console > Project settings > General > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web configuration > Generate key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
